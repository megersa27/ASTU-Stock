generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())

  products  Product[]
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  sku         String    @unique
  price       Float
  stock       Int       @default(0)
  createdAt   DateTime  @default(now())

  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id])
}