# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astu_db?schema=public

# JWT
JWT_SECRET=replace_with_secure_value
# Optional: override token expiry
JWT_EXPIRES_IN=1d

# SMTP (optional)
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=you@example.com
#SMTP_PASS=supersecret
#SMTP_FROM="ASTU Stock System <no-reply@astu.edu.et>"

# Resend (optional)
#RESEND_API_KEY=
#RESEND_FROM="ASTU Stock System <no-reply@astu.edu.et>"
